{
  "name": "grabshift",
  "version": "2.0.0",
  "description": "A solo and local multiplayer physics brawler. Two hands. Three bot difficulties. Hold on.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "test:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "matter-js": "0.20.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.19.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
